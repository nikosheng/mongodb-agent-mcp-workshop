# ============================================================================
# ATTENDEE CONFIG — fill in these two, nothing else required.
# ============================================================================

# Pick a short, unique handle (e.g. your name or initials). Used to tag any
# titles you contribute to the shared catalog, e.g. "alice" or "team3".
WORKSHOP_USER_ID=change-me

# ============================================================================
# SHARED WORKSHOP CREDENTIALS — provided by the workshop admin/handout.
# These are scoped, least-privilege credentials shared by all attendees.
# Do NOT commit real values. This file is a template only.
# ============================================================================

# workshop_demo_user: readWrite on the `streaming_catalog` database ONLY.
# Used by the local MongoDB MCP Server subprocess for all catalog operations
# (find / aggregate / insert-many). Has zero access to the admin settings
# below. No Voyage API key is needed — the vector search index uses Atlas's
# Automated Embedding feature, which Atlas hosts and manages entirely
# server-side (no embedding key configured anywhere in this app).
MONGODB_DEMO_CONNECTION_STRING=mongodb+srv://workshop_demo_user:PASSWORD@your-cluster.mongodb.net/?retryWrites=true&w=majority

# workshop_readonly_user: READ-ONLY on the `workshop_admin` database ONLY.
# Used by the Mastra server to look up whether the demo is currently active
# and to fetch the current (admin-rotated) Grove AI Gateway key. Attendees
# cannot write to this collection with this credential.
MONGODB_ADMIN_READONLY_CONNECTION_STRING=mongodb+srv://workshop_readonly_user:PASSWORD@your-cluster.mongodb.net/?retryWrites=true&w=majority

# ============================================================================
# ADMIN-ONLY — do not distribute to attendees. Used only by admin/*.
# ============================================================================

# workshop_admin_user: readWrite on the `workshop_admin` database ONLY.
# ADMIN_CONNECTION_STRING=mongodb+srv://workshop_admin_user:PASSWORD@your-cluster.mongodb.net/?retryWrites=true&w=majority

# Atlas CLI / Admin API context used by admin/provision-workshop.ts
# to create the three scoped database users and open the IP access list.
# ATLAS_PROJECT_ID=
# ATLAS_CLUSTER_HOST=your-cluster.abcde.mongodb.net

# Secret the admin seeds into workshop_admin.settings (never read by attendees).
# ADMIN_AI_GATEWAY_API_KEY=
