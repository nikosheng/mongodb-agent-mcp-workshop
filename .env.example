# ============================================================================
# ATTENDEE CONFIG — fill in these two, nothing else required.
# ============================================================================

# Pick a short, unique handle (e.g. your name or initials). Used to tag any
# titles you contribute to the shared catalog, e.g. "alice" or "team3".
WORKSHOP_USER_ID=change-me

# ============================================================================
# SHARED WORKSHOP CREDENTIALS — provided by the workshop admin/handout.
# These are scoped, least-privilege credentials shared by all attendees.
# Do NOT commit real values. This file is a template only.
# ============================================================================

# workshop_demo_user: readWrite on the `streaming_catalog` database ONLY.
# Used by the local MongoDB MCP Server subprocess for all catalog operations
# (find / aggregate / insert-many), and by the Part 1 notebook (pymongo) to
# create/query your own personal sandbox collection. Has zero access to the
# admin settings below. You never need your own Voyage API key — Part 2's
# production index uses Atlas's Automated Embedding feature (hosted and
# managed entirely server-side), and Part 1's notebook fetches a shared,
# admin-controlled Voyage API key at runtime (see
# MONGODB_ADMIN_READONLY_CONNECTION_STRING below).
MONGODB_DEMO_CONNECTION_STRING=mongodb+srv://workshop_demo_user:PASSWORD@your-cluster.mongodb.net/?retryWrites=true&w=majority

# workshop_readonly_user: READ-ONLY on the `workshop_admin` database ONLY.
# Used by the Mastra server (Part 2) to look up whether the demo is
# currently active and fetch the current (admin-rotated) Grove AI Gateway
# key, and by the Part 1 notebook to fetch the current (admin-rotated)
# Voyage AI API key. Attendees cannot write to this collection with this
# credential.
MONGODB_ADMIN_READONLY_CONNECTION_STRING=mongodb+srv://workshop_readonly_user:PASSWORD@your-cluster.mongodb.net/?retryWrites=true&w=majority
